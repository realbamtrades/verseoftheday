# Copy this file to .env for local testing.
# On Railway/Render, set these same names as environment variables in the dashboard instead.

DISCORD_TOKEN=your_bot_token_here
CHANNEL_ID=123456789012345678

# Optional overrides:
# Bible translation: kjv, web, bbe, oeb-us (via bible-api.com), or nlt (via Tyndale's official NLT API)
TRANSLATION=nlt
# Only used when TRANSLATION=nlt. "TEST" works for low daily volume (this bot
# only needs 1 request/day). Get your own free key at https://api.nlt.to if desired.
NLT_API_KEY=TEST
# Hour (24h, Eastern Time) the bot posts at. 9 = 9:00 AM Eastern.
POST_HOUR=9
