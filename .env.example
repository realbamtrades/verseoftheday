# Copy this file to .env for local testing.
# On Railway/Render, set these same names as environment variables in the dashboard instead.

DISCORD_TOKEN=your_bot_token_here
CHANNEL_ID=123456789012345678

# Optional overrides:
# Bible translation returned by bible-api.com (kjv, web, oeb-us, etc.)
TRANSLATION=kjv
# Hour (24h, Eastern Time) the bot posts at. 9 = 9:00 AM Eastern.
POST_HOUR=9
